   ],
   "source": [
    "# Create empty shopping cart\n",
    "cart = []\n",
    "\n",
    "# Add items\n",
    "cart.append(\"Apple\")\n",
    "cart.append(\"Milk\")\n",
    "cart.append(\"Bread\")\n",
    "print(\"Items in cart:\", cart)\n",
    "\n",
    "# Remove one item\n",
    "cart.remove(\"Milk\")\n",
    "\n",
    "print(\"After removing one item:\", cart)\n",
    "\n",
    "# Print total items\n",
    "print(\"Total items:\", len(cart))"
   ]
  },
